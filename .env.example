# Copy to .env; never commit actual credentials. Use URL-safe hexadecimal DB passwords.
POSTGRES_DB=mi_entreno
POSTGRES_USER=mi_entreno
POSTGRES_PASSWORD=replace_with_random_hex
DATABASE_URL=postgres://mi_entreno:replace_with_random_hex@localhost:5432/mi_entreno
AUTH_USERNAME=owner
# Run npm run password; paste salt:hash here, not the plaintext password.
AUTH_PASSWORD_HASH=
APP_ORIGIN=http://localhost:3000
# VPS: your DNS hostname; APP_ORIGIN must be https://your-hostname
DOMAIN=localhost
